{
  "options": {
    "listenPort": 8080,
    "serveFrontPage": true,
    "serveSwagger": true,
    "RestartOnConfigChange": true,
    "process": 1,
    "thread": 2
  },
  "styles": {},
  "geojsons": {},
  "datas": {
    "hanoi-sample": {
      "mbtiles": "hanoi-sample.mbtiles"
    },
    "satellite": {
      "xyz": "satellite",
      "cache": {
        "forward": true,
        "store": false
      },
      "tilejson": {
        "name": "Satellite basemap",
        "type": "baselayer",
        "scheme": "xyz",
        "format": "jpg",
        "minzoom": 0,
        "maxzoom": 18,
        "bounds": [-180, -85.051129, 180, 85.051129]
      }
    },
    "satellite2": {
      "mbtiles": "satellite2",
      "cache": {
        "forward": true,
        "store": false
      }
    }
  },
  "sprites": {},
  "fonts": {}
}
